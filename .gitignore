node_modules/
serve.log

# Google Drive folder metadata, one per directory, never useful in a repo.
desktop.ini

# Verification captures. lab/ holds two different kinds of thing: the tools,
# which are source and belong here, and what they produce, which is tens of
# megabytes of frame walks and contact sheets regenerated by running them.
# The tools default their output to the system temp folder for the same
# reason; these patterns catch the runs that were written here before that.
lab/**/*.png
lab/**/*.jpg
lab/**/*.jpeg
lab/shots/
lab/mobile/
lab/reduced/
